# ==========================================
# KONFIGURASI MICROSOFT GRAPH API (WAJIB DIISI)
# ==========================================
# Ambil nilai-nilai ini dari Azure Portal / Microsoft Entra ID
# (Lihat README.md bagian "Panduan Setup Microsoft Graph API")

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ID unik file Excel di OneDrive (Database_Anggota_RNI_Sederhana.xlsx)
EXCEL_FILE_ID=

# ID pengguna/drive pemilik file OneDrive (biasanya alamat email akun Microsoft)
ONEDRIVE_USER_ID=

# Nama sheet tempat data anggota disimpan
EXCEL_WORKSHEET_NAME=DATA ANGGOTA

# ==========================================
# KONFIGURASI SERVER
# ==========================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================================
# KONFIGURASI ADMIN LOGIN
# ==========================================
# Gunakan hash bcrypt untuk password (jangan simpan password polos).
# Untuk membuat hash, lihat instruksi di README.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Kunci rahasia untuk menandatangani token login admin (JWT).
# Isi dengan string acak yang panjang dan rahasia.
JWT_SECRET=ganti_dengan_string_acak_yang_sangat_panjang_dan_rahasia
